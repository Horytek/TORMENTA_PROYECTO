# Clave maestra para cifrar/descifrar credenciales guardadas en la tabla `clave`
# (SOL, certificado, etc. de cada empresa/tenant). 32 bytes en hex (64 caracteres).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatoria: sin ella no se pueden leer ni guardar claves. No hay fallback al
# esquema anterior (clave hardcodeada) — cualquier clave guardada con ese
# esquema debe reingresarse desde el panel una vez configurada esta variable.
CREDENTIALS_ENCRYPTION_KEY=

# === SUNAT (CPE) ===
SUNAT_ENV=beta
# Opcional: sobreescribe el WSDL
# SUNAT_BILL_WSDL_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService?wsdl

# Opcional: WSDL para GRE
# SUNAT_GRE_WSDL_URL=https://e-beta.sunat.gob.pe/ol-ti-itemision-guia-gem-beta/billService?wsdl

# Credenciales SOL
# Opción A: username completo
# SUNAT_SOL_USERNAME=
# SUNAT_SOL_PASS=

# Opción B: username = RUC + usuario SOL
# SUNAT_RUC=
# SUNAT_SOL_USER=
# SUNAT_SOL_PASS=

# Certificado digital (.p12)
# SUNAT_CERT_P12_PATH=
# SUNAT_CERT_P12_PASS=

# Alternativa: embebido en base64 (si no quieres archivo en disco)
# SUNAT_CERT_P12_BASE64=

