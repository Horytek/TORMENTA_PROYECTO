{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run client:*)",
      "Bash(npm run dev:full:*)",
      "Bash(npm run dev:fullstack)",
      "Bash(npm run build:client)",
      "Bash(npm install)",
      "Bash(npm --prefix client install)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(node --version)",
      "Bash(npm --version)"
    ],
    "deny": [
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.base64.txt)",
      "Read(./cert.base64.txt)"
    ]
  }
}
